{
  "name": "agentdeck",
  "productName": "AgentDeck",
  "version": "0.0.0-development",
  "private": true,
  "description": "AI sessions, projects and voice in one place: a Windows launcher for AI coding sessions",
  "license": "MIT",
  "author": "MitrevStudio",
  "repository": "github:MitrevStudio/-AgentDeck",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test:git": "node scripts/test-git-repositories.js && node scripts/test-git-panel.js && node scripts/test-git-diff-ui.js",
    "test:layout": "node scripts/test-layout-sync.js",
    "test:relay": "node scripts/test-relay.js",
    "test:limits": "node scripts/test-limits.js",
    "test:audit": "node scripts/test-audit-regressions.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never"
  },
  "//": "build.files: soundtouchjs ships a demo page and song (public/) the app never loads. build.asarUnpack: koffi loads its native addon (koffi.node from @koromix/koffi-win32-x64) with process.dlopen, which needs a real file on disk, so both packages stay outside app.asar (resources/app.asar.unpacked). Everything else, the selection worker and the AudioWorklet modules included, loads fine from app.asar.",
  "build": {
    "appId": "com.mitrevstudio.agentdeck",
    "productName": "AgentDeck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "native/**",
      "package.json",
      "!node_modules/soundtouchjs/{public,scripts}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AgentDeck-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MitrevStudio",
        "repo": "-AgentDeck"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.10",
    "koffi": "^3.3.3",
    "selfsigned": "^5.5.0",
    "soundtouchjs": "^0.3.0",
    "ws": "^8.22.1"
  }
}
