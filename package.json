{
  "name": "agentdeck",
  "productName": "AgentDeck",
  "version": "0.0.0-development",
  "private": true,
  "description": "AI sessions, projects and voice in one place: a Windows launcher for AI coding sessions",
  "license": "MIT",
  "author": "MitrevStudio",
  "repository": "github:MitrevStudio/-AgentDeck",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "setup:linux": "node node_modules/electron/install.js && electron-rebuild -f -o node-pty",
    "check": "node scripts/check.js",
    "test:git": "node scripts/test-git-repositories.js && node scripts/test-git-panel.js && node scripts/test-git-diff-ui.js && node scripts/test-git-actions.js && node scripts/test-git-workflow-ui.js",
    "test:git-ui": "node scripts/test-git-ui-electron.cjs",
    "test:manager-ui": "node scripts/test-manager-ui-electron.cjs",
    "test:bar-ui": "node scripts/test-bar-ui-electron.cjs",
    "test:layout": "node scripts/test-layout-sync.js",
    "test:devices": "node scripts/test-device-view.js",
    "test:relay": "node scripts/test-relay.js",
    "test:mesh": "node scripts/test-mesh.js",
    "test:pairing": "node scripts/test-mesh-pairing.js",
    "test:mesh-proxy": "node scripts/test-mesh-proxy.js",
    "test:mesh-relay-only": "node scripts/test-mesh-relay-only.js",
    "test:host-pair": "node scripts/test-host-pair.js",
    "test:limits": "node scripts/test-limits.js",
    "test:updater": "node scripts/test-updater.js",
    "test:live": "node scripts/test-live-jobs.js",
    "test:context": "node scripts/test-session-context.js && node scripts/test-opencode-sessions.js",
    "test:audit": "node scripts/test-audit-regressions.js",
    "test:themes": "node scripts/test-themes.js",
    "test:prefs": "node scripts/test-prefs-compact.js",
    "dist": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --win --dir --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "//": "build.files: soundtouchjs ships a demo page and song (public/) the app never loads. build.asarUnpack: koffi loads its native addon (koffi.node from @koromix/koffi-win32-x64) with process.dlopen, which needs a real file on disk, so both packages stay outside app.asar (resources/app.asar.unpacked). Everything else, the selection worker and the AudioWorklet modules included, loads fine from app.asar.",
  "build": {
    "appId": "com.mitrevstudio.agentdeck",
    "productName": "AgentDeck",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "native/**",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/soundtouchjs/{public,scripts}/**"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/koffi-win32-x64/**",
      "node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "executableName": "agentdeck",
      "artifactName": "AgentDeck-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AgentDeck-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MitrevStudio",
        "repo": "-AgentDeck"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.10",
    "koffi": "^3.3.3",
    "selfsigned": "^5.5.0",
    "soundtouchjs": "^0.3.0",
    "ws": "^8.22.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
