<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>AgentDeck</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- The version of the GitHub release and a build number made of it (scripts/xcode.mjs), as on Android. -->
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance is not answered here (no ITSAppUsesNonExemptEncryption): App Store Connect asks for every
	     build, and the answer is the account holder's to give. The app encrypts what it sends with its own
	     implementation (in JavaScript) of standard algorithms - Noise XX over X25519, ChaCha20-Poly1305 and SHA-256
	     (docs/MOBILE.md 3.1) - not with the encryption of iOS. "Yes" here is taken only together with the code of
	     the encryption documentation filed for the app (ITSEncryptionExportComplianceCode); docs/MOBILE.md 11. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- The app talks plain ws:// to the user's relay at any address, an IP or a host name, in the house or on the
	     internet; the traffic is encrypted at application level (Noise). The page is the only thing that opens
	     connections, so the exception is the web view's alone (the app's own native code keeps the default), and
	     local addresses are named for the systems that read only that. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The QR scanner (getUserMedia in the web view) and "Take a photo" for a terminal. A picture chosen from the
	     library comes through the system's picker, which asks for nothing. -->
	<key>NSCameraUsageDescription</key>
	<string>AgentDeck uses the camera to scan the pairing code from your computer, and to take a photo you send to a session.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>AgentDeck connects to your own relay and computers, which may be on this network.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- The app is dark only: the status bar's text is light, the keyboard dark. -->
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
